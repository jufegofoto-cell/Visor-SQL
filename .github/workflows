name: Compilar Windows x64

on:
  push:
    tags: ['v*']        # ej.: git tag v2.3.0 && git push origin v2.3.0  → compila y publica en Releases
  workflow_dispatch:     # ejecución manual desde la pestaña Actions (deja el .exe como artefacto)

permissions:
  contents: write

jobs:
  build:
    runs-on: windows-latest
    steps:
      - name: Descargar repositorio
        uses: actions/checkout@v4

      - name: Instalar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Versión desde la etiqueta
        if: startsWith(github.ref, 'refs/tags/v')
        shell: bash
        run: npm version "${GITHUB_REF_NAME#v}" --no-git-tag-version --allow-same-version

      - name: Instalar dependencias
        run: npm ci --no-audit --no-fund

      - name: Validar HTML
        run: npm run validate

      - name: Compilar ejecutable portable (x64)
        run: npm run dist
        env:
          CSC_IDENTITY_AUTO_DISCOVERY: false   # sin certificado de firma de código

      - name: Guardar artefacto
        uses: actions/upload-artifact@v4
        with:
          name: VisorSQL-EnergyPlus-win-x64
          path: dist/*.exe
          if-no-files-found: error

      - name: Publicar en GitHub Releases
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: dist/*.exe
          generate_release_notes: true

