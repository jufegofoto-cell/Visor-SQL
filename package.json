{
  "name": "visor-sql-energyplus",
  "productName": "Visor SQL EnergyPlus",
  "version": "2.4.0",
  "description": "Visor offline de resultados SQL de EnergyPlus / OpenStudio (también EPW y CSV), con funciones estilo DView.",
  "main": "main.js",
  "author": "jufegofoto-cell",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "validate": "node scripts/validate.js",
    "dist": "electron-builder --win portable nsis --x64 --publish never",
    "dist:installer": "electron-builder --win nsis --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "co.jufegofoto.visorsqlenergyplus",
    "productName": "Visor SQL EnergyPlus",
    "copyright": "© 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "app/**/*",
      "build/icon.ico"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "VisorSQL-EnergyPlus-${version}-portable-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Visor SQL EnergyPlus",
      "uninstallDisplayName": "Visor SQL EnergyPlus ${version}",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "artifactName": "VisorSQL-EnergyPlus-${version}-instalador-x64.exe"
    }
  }
}
